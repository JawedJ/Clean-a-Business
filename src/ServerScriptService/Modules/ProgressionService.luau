--!strict

-- Server authority for player progression: awarding Cash and XP, and resolving
-- level-ups. Every reward in the game funnels through here so the leveling rules
-- live in exactly one place. All writes go through DataService so they replicate
-- to the client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DataService = require(ReplicatedStorage.Packages.DataService).server
local Leveling = require(ReplicatedStorage.SharedModules.Leveling)
local SkillsService = require(script.Parent.SkillsService)

local RewardPopup = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RewardPopup") :: RemoteEvent

local ProgressionService = {}

-- Adds `cash` to the player's balance, boosted by their Greed skill. No-op for non-positive
-- amounts. The skill multiplier is applied here, at the single funnel every cash reward passes
-- through, so no caller needs to know about it. Returns the boosted amount actually credited (0
-- if nothing was), so a caller can display exactly what it paid.
function ProgressionService.awardCash(player: Player, cash: number): number
	if cash <= 0 then
		return 0
	end
	local boosted = math.floor(cash * SkillsService.getMultiplier(player, "Greed"))
	DataService:update(player, { "Cash" }, function(current: number?)
		return (current or 0) + boosted
	end)
	return boosted
end

-- Adds `gems` to the player's gem balance, boosted by their Hoarding skill. No-op for non-positive
-- amounts. Gems are the secondary currency generated by unlocked plot spawnables (see
-- PlotButtonService). Returns the boosted amount actually credited.
function ProgressionService.awardGems(player: Player, gems: number): number
	if gems <= 0 then
		return 0
	end
	local boosted = math.floor(gems * SkillsService.getMultiplier(player, "Hoarding"))
	DataService:update(player, { "Gems" }, function(current: number?)
		return (current or 0) + boosted
	end)
	return boosted
end

-- Adds `xp` to the player's level, boosted by their Inteligence skill, applying any level-ups via
-- Leveling. No-op for non-positive amounts. Returns the boosted amount actually credited.
function ProgressionService.awardXp(player: Player, xp: number): number
	if xp <= 0 then
		return 0
	end
	local boosted = math.floor(xp * SkillsService.getMultiplier(player, "Inteligence"))
	DataService:update(player, { "Level" }, function(level)
		return Leveling.addXp(level, boosted)
	end)
	return boosted
end

-- Convenience: award XP and Cash together, and tell the client to show its floating
-- "+N XP! / +N Cash!" popups for whatever was actually granted -- the boosted amounts the awards
-- returned, so the popups match the balance jump rather than the pre-skill base.
function ProgressionService.reward(player: Player, xp: number, cash: number)
	local grantedXp = ProgressionService.awardXp(player, xp)
	local grantedCash = ProgressionService.awardCash(player, cash)
	RewardPopup:FireClient(player, grantedXp, grantedCash)
end

return ProgressionService
