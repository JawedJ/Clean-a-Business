--!strict

-- Server authority for player progression: awarding Cash and XP, and resolving
-- level-ups. Every reward in the game funnels through here so the leveling rules
-- live in exactly one place. All writes go through DataService so they replicate
-- to the client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DataService = require(ReplicatedStorage.Packages.DataService).server
local Leveling = require(ReplicatedStorage.SharedModules.Leveling)
local ShopPerks = require(script.Parent.ShopPerks)
local SkillsService = require(script.Parent.SkillsService)

local RewardPopup = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RewardPopup") :: RemoteEvent

local ProgressionService = {}

-- Adds `cash` to the player's balance, boosted by their Greed skill and by the store's permanent
-- 2x Cash perk if they've bought it. No-op for non-positive amounts. Both multipliers are applied
-- here, at the single funnel every cash reward passes through, so no caller needs to know about
-- them. Returns the boosted amount actually credited (0 if nothing was), so a caller can display
-- exactly what it paid.
--
-- Note the store's own cash PACKS deliberately do not come through here (ShopProductsService
-- credits them raw) -- a 100k pack pays 100k, not 100k times the perk the same store sold you.
function ProgressionService.awardCash(player: Player, cash: number): number
	if cash <= 0 then
		return 0
	end
	local boosted = math.floor(cash * SkillsService.getMultiplier(player, "Greed") * ShopPerks.getCashMultiplier(player))
	DataService:update(player, { "Cash" }, function(current: number?)
		return (current or 0) + boosted
	end)
	return boosted
end

-- Adds `gems` to the player's gem balance, boosted by their Hoarding skill and by the store's
-- permanent 2x Gems perk if they've bought it. No-op for non-positive amounts. Gems are the
-- secondary currency generated by unlocked plot spawnables (see PlotButtonService). Returns the
-- boosted amount actually credited.
--
-- The gem grants that deliberately bypass this funnel (offline earnings, the Company UI's claim +
-- boost, the store's own gem packs) are unaffected by the perk, as they are by Hoarding -- each
-- has its own reason for crediting raw; see those modules.
function ProgressionService.awardGems(player: Player, gems: number): number
	if gems <= 0 then
		return 0
	end
	local boosted = math.floor(gems * SkillsService.getMultiplier(player, "Hoarding") * ShopPerks.getGemMultiplier(player))
	DataService:update(player, { "Gems" }, function(current: number?)
		return (current or 0) + boosted
	end)
	return boosted
end

-- Adds `xp` to the player's level, boosted by their Inteligence skill, applying any level-ups via
-- Leveling. No-op for non-positive amounts. Returns the boosted amount actually credited.
function ProgressionService.awardXp(player: Player, xp: number): number
	if xp <= 0 then
		return 0
	end
	local boosted = math.floor(xp * SkillsService.getMultiplier(player, "Inteligence"))
	DataService:update(player, { "Level" }, function(level)
		return Leveling.addXp(level, boosted)
	end)
	return boosted
end

-- Convenience: award XP and Cash together, and tell the client to show its floating
-- "+N XP! / +N Cash!" popups for whatever was actually granted -- the boosted amounts the awards
-- returned, so the popups match the balance jump rather than the pre-skill base.
function ProgressionService.reward(player: Player, xp: number, cash: number)
	local grantedXp = ProgressionService.awardXp(player, xp)
	local grantedCash = ProgressionService.awardCash(player, cash)
	RewardPopup:FireClient(player, grantedXp, grantedCash)
end

-- The same award, with NO popup and no chime. The money and XP land identically (and the HUD
-- counters still move, since they read the saved values) -- the only difference is that the player
-- isn't told about it in text. For a reward that pays continuously rather than on a discrete act:
-- the wash reward ticks once a second for as long as the trigger is held, which as a stream of
-- popups is just noise over the crosshair. See CleaningService.
function ProgressionService.rewardSilently(player: Player, xp: number, cash: number)
	ProgressionService.awardXp(player, xp)
	ProgressionService.awardCash(player, cash)
end

return ProgressionService
